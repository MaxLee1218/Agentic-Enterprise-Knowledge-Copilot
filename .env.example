APP_ENV=development

# Must remain false in production.
DEBUG=false

LOG_LEVEL=INFO

# JSON is the production/test-safe default; use text only for local readability.
LOG_FORMAT=json

OBSERVABILITY_ENABLED=true

METRICS_ENABLED=true

TRACE_ENABLED=true

# p50/p95 use the most recent bounded samples in each metric series.
METRICS_WINDOW_SIZE=1000

# The local trace store is bounded by completed span count.
MAX_TRACE_SPANS=10000

MAX_TRACE_ATTRIBUTES=32

MAX_TRACE_ATTRIBUTE_LENGTH=256

MAX_LOG_SUMMARY_LENGTH=512

RAG_BASE_URL=http://127.0.0.1:8000

RAG_TIMEOUT_SECONDS=30

RAG_MAX_ATTEMPTS=3

RAG_RETRY_BASE_DELAY_SECONDS=0.2

RAG_USER_AGENT=agentic-enterprise-knowledge-copilot/0.1.0

RAG_TRACE_HEADER=X-Trace-ID

# mock keeps local tests offline; http uses the independent Enterprise RAG Engine.
KNOWLEDGE_PROVIDER=mock

LLM_PROVIDER=mock

LLM_MODEL=deepseek-chat

LLM_BASE_URL=https://api.deepseek.com

# Required only when LLM_PROVIDER=deepseek. Keep the real value out of source control.
LLM_API_KEY=

LLM_CONNECT_TIMEOUT_SECONDS=10

LLM_READ_TIMEOUT_SECONDS=60

LLM_MAX_RETRIES=2

LLM_RETRY_BASE_DELAY_SECONDS=0.2

LLM_MAX_OUTPUT_TOKENS=4096

LLM_TEMPERATURE=0

LLM_USER_AGENT=agentic-enterprise-knowledge-copilot/0.1.0

LLM_TRACE_HEADER=X-Trace-ID

MAX_PLAN_REPAIR_ATTEMPTS=2

# Enterprise BUSINESS database used only by the governed read-only Database Tool.
DATABASE_URL=sqlite:///data/database/enterprise_demo.db

# mock is the portable local default; sqlalchemy enables the registered SELECT-only adapter.
DATABASE_PROVIDER=mock

DATABASE_STATEMENT_TIMEOUT_SECONDS=8

# Frozen database schema permits at most 10000 rows; configuration may only tighten it.
MAX_DATABASE_ROWS=10000

# Copilot INTERNAL persistence database (Task, State, Evidence, Approval, Audit, Artifact metadata).
# Omit locally to reuse CHECKPOINT_DATABASE_PATH as SQLite. Production must set PostgreSQL.
PERSISTENCE_DATABASE_URL=

# Development/test compatibility helper only. Set false when Alembic owns schema deployment.
PERSISTENCE_AUTO_CREATE_SCHEMA=true

DB_POOL_SIZE=5

DB_MAX_OVERFLOW=10

DB_POOL_TIMEOUT_SECONDS=30

DB_POOL_RECYCLE_SECONDS=1800

DB_CONNECT_MAX_ATTEMPTS=5

DB_CONNECT_RETRY_DELAY_SECONDS=1

ARTIFACT_DIR=data/artifacts

REPORT_MAX_SIZE_BYTES=10485760

MAX_EVIDENCE_ITEMS=500

MAX_STEP_DURATION_SECONDS=60

MAX_TASK_STEPS=10

MAX_TASK_TEXT_LENGTH=10000

MAX_TASK_METADATA_BYTES=16384

MAX_TASK_METADATA_DEPTH=5

MAX_TASK_METADATA_ITEMS=100

TASK_FORCE_READ_ONLY=true

TASK_REQUIRE_APPROVAL_BY_DEFAULT=false

# development/test may use demo only when the entry point makes demo mode explicit.
# Production must use trusted_headers and a deployment-injected signing secret.
IDENTITY_PROVIDER=demo

# Required for IDENTITY_PROVIDER=trusted_headers. Keep the real value in a secret manager.
IDENTITY_SIGNING_SECRET=

IDENTITY_ASSERTION_MAX_AGE_SECONDS=60

# Safe local identity only. These values are never a production authentication fallback.
DEMO_USER_ID=U-DEMO

DEMO_TENANT_ID=TENANT-DEMO

# Comma-separated values are parsed by Pydantic Settings as a JSON array.
DEMO_APPROVAL_ROLES=["quality_analyst"]

APPROVAL_TTL_SECONDS=86400

WORKFLOW_MAX_RETRIES=2

WORKFLOW_RETRY_DELAY_SECONDS=0

WORKFLOW_ENGINE=langgraph

CHECKPOINT_ENABLED=true

CHECKPOINT_DATABASE_PATH=data/database/workflow-checkpoints.db

CHECKPOINT_CONNECTION_TIMEOUT_SECONDS=5

CHECKPOINT_CLEANUP_POLICY=retain

MAX_REPLAN_COUNT=2

MAX_TOTAL_EXECUTION_SECONDS=300

GRAPH_RECURSION_LIMIT=100

# Stage 18 MCP roles are disabled by default. The protocol revision is intentionally pinned.
MCP_ENABLED=false
MCP_CLIENT_ENABLED=false
MCP_SERVER_ENABLED=false
MCP_PROTOCOL_REVISION=2025-11-25
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp
MCP_ALLOW_PUBLIC_BIND=false
MCP_ALLOWED_HOSTS='["127.0.0.1","localhost"]'
MCP_ALLOWED_ORIGINS='[]'
MCP_EXPORT_ALLOWLIST='[]'
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_INITIALIZE_TIMEOUT_SECONDS=15
MCP_INVOCATION_TIMEOUT_SECONDS=60
MCP_SAMPLING_ENABLED=false
MCP_ELICITATION_ENABLED=false
# Required only when MCP_SERVER_ENABLED=true. Put the real key in a secret manager/runtime env.
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_JWT_SIGNING_KEY=
# Names only; values remain in runtime environment and are resolved by reference.
MCP_ENV_CREDENTIAL_NAMES='[]'

# Docker Compose inputs. These local demo credentials must never be used in production.
POSTGRES_DB=copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_local_password
POSTGRES_PORT=5432
BUSINESS_POSTGRES_PASSWORD=quality_seed_local_password
BUSINESS_POSTGRES_PORT=5433
COPILOT_PORT=8000
RAG_PORT=8001

# Name of an image built from the independent Enterprise RAG Engine repository.
RAG_IMAGE=enterprise-rag-engine:local
