{
  "name": "enterprise-agent-execution-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:export": "python ../scripts/export_frontend_openapi.py --output openapi/openapi.json",
    "api:types": "openapi-typescript openapi/openapi.json -o src/api/generated/schema.d.ts",
    "api:generate": "npm run api:export && npm run api:types",
    "api:check": "npm run api:generate && git diff --exit-code -- openapi/openapi.json src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.1",
    "@tanstack/react-query": "5.85.5",
    "openapi-fetch": "0.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "react-router-dom": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "msw": "2.10.5",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
