# Local Enterprise single-machine E2E configuration.
# Copy this file to .env.local-enterprise and replace placeholders locally.
# Never commit .env.local-enterprise or real credentials.

FRONTEND_PORT=8080
LOG_LEVEL=INFO

# Copilot internal PostgreSQL. Development-only values; change them in the local file.
COPILOT_POSTGRES_DB=copilot
COPILOT_POSTGRES_USER=copilot
COPILOT_POSTGRES_PASSWORD=copilot_local_enterprise_password

# Enterprise business PostgreSQL administrator used only by the explicit seed job.
BUSINESS_POSTGRES_DB=supplier_quality
BUSINESS_POSTGRES_ADMIN_USER=quality_seed
BUSINESS_POSTGRES_ADMIN_PASSWORD=quality_seed_local_enterprise_password

# Runtime credential held only by copilot-api. PostgreSQL also enforces read-only transactions.
BUSINESS_READONLY_USER=quality_readonly
BUSINESS_READONLY_PASSWORD=quality_readonly_local_enterprise_password

# Local-only demo identity. Production identity guardrails are unchanged.
DEMO_USER_ID=U-LOCAL-ENTERPRISE
DEMO_TENANT_ID=TENANT-DEMO
DEMO_APPROVAL_ROLES=["quality_analyst"]
TASK_REQUIRE_APPROVAL_BY_DEFAULT=false

# Copilot task-understanding/planning provider. A real key is required for the full DeepSeek gate.
COPILOT_LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Formal Enterprise RAG image built and owned by the sibling repository.
ENTERPRISE_RAG_IMAGE=enterprise-rag-engine:local
ENTERPRISE_RAG_DOCUMENTS_PATH=../Enterprise-RAG-Engine/enterprise-documents

# RAG generation is a separate data boundary. The safe default is the backend-only local stub;
# retrieval still uses the formal PDF/embedding/Chroma/BM25/hybrid/reranker pipeline.
ENTERPRISE_RAG_DEEPSEEK_API_KEY=local-generation-stub
ENTERPRISE_RAG_DEEPSEEK_BASE_URL=http://rag-generation-stub:8000
ENTERPRISE_RAG_DEEPSEEK_MODEL=local-grounded-generation
ENTERPRISE_RAG_DEEPSEEK_TIMEOUT=30
ENTERPRISE_RAG_COLLECTION=supplier_quality_demo
ENTERPRISE_RAG_CHUNK_MODE=standard
ENTERPRISE_RAG_QUERY_REWRITE_ENABLED=false
ENTERPRISE_RAG_RERANKER_ENABLED=true
ENTERPRISE_RAG_RERANKER_LOCAL_FILES_ONLY=false

RAG_TIMEOUT_SECONDS=10
RAG_MAX_ATTEMPTS=3
